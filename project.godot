; Engine configuration file.
config_version=5

[application]

config/name="Hollow Arrow"
config/description="A boss-rush action game. One arrow. One life."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

Game="*res://scripts/systems/game.gd"
Sfx="*res://scripts/systems/sfx.gd"
Autotest="*res://scripts/systems/autotest.gd"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="boss_body"
2d_physics/layer_4="hazard"
2d_physics/layer_5="weakpoint"
2d_physics/layer_6="armor"
2d_physics/layer_7="switch"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
